# Supabase (opcional). Sin estas variables la app funciona igual: los ajustes y
# presets se guardan en localStorage en vez de en la nube.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Modelos de MediaPipe. Por defecto se descargan del bucket público de Google;
# define estas variables para servirlos desde tu propio origen o una CDN.
# NEXT_PUBLIC_POSE_MODEL_URL=/mediapipe/models/pose_landmarker_lite.task
# NEXT_PUBLIC_FACE_MODEL_URL=/mediapipe/models/face_landmarker.task
